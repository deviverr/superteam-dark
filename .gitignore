# Saved reference copy of the live site (large, third-party content)
site_example/

# Build output (generated by store/build.py, attached to releases instead)
dist/

# OS cruft
.DS_Store
._*
__pycache__

# Safari: staged web extension, regenerated by safari/build.py from the
# shared runtime + manifest.safari.json. The Xcode project it feeds IS
# committed; this intermediate copy is not.
safari/extension/

# Xcode per-user state and build output
xcuserdata/
*.xcuserstate
DerivedData/
build/
