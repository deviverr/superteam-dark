{
  "manifest_version": 3,
  "name": "Superteam Earn Dark",
  "version": "1.2.0",
  "description": "Dark mode, themes, and full customization for Superteam Earn — quick toggle, 8 presets, custom colors, wallpaper, and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Superteam Earn Dark"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://superteam.fun/earn*", "*://*.superteam.fun/earn*"],
      "js": ["content/content.js"],
      "css": ["content/dark.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["*://superteam.fun/*", "*://*.superteam.fun/*"]
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["*://superteam.fun/earn*", "*://*.superteam.fun/earn*"]
}
